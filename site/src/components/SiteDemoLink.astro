---
/** "Try it live": the multi-page site demo on the public host (PUBLIC_DEMO_URL + site.html), or how to run it. */
import { LinkCard } from './ui'
const demo = import.meta.env.PUBLIC_DEMO_URL as string | undefined
const url = demo ? `${demo.replace(/\/?$/, '/')}site.html` : null
---
{url ? (
  <LinkCard class="sdl" href={url} title="Try it live" tint>A small site with loans, a barbershop, a FAQ and two forms. One chat across all of it.</LinkCard>
) : (
  <p class="sdl-off">Try it locally: <code>cd frontend && npm run build</code>, start the demo server, open <code>http://localhost:8000/site.html</code>.</p>
)}

<style>
  .sdl { margin: 1.25rem 0; }
</style>
