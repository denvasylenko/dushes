---
/** "Try it live": the multi-page site demo on the public host (PUBLIC_DEMO_URL + site.html), or how to run it. */
const demo = import.meta.env.PUBLIC_DEMO_URL as string | undefined
const url = demo ? `${demo.replace(/\/?$/, '/')}site.html` : null
---
{url ? (
  <a class="sdl not-content" href={url}>
    <span><b>Try it live</b> A small site with loans, a barbershop, a FAQ and two forms. One chat across all of it.</span>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
  </a>
) : (
  <p class="sdl-off">Try it locally: <code>cd frontend && npm run build</code>, start the demo server, open <code>http://localhost:8000/site.html</code>.</p>
)}

<style>
  .sdl { display: flex; align-items: center; gap: 16px; margin: 1.25rem 0; padding: 16px 20px; border-radius: 20px; text-decoration: none;
    background: var(--sl-color-accent-low); color: var(--sl-color-white); transition: transform .18s; }
  .sdl:hover { transform: translateY(-1px); }
  .sdl span { flex: 1; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .sdl b { display: block; font-size: var(--sl-text-base); color: var(--sl-color-white); margin-bottom: 2px; }
  .sdl svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .sdl:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .sdl { transition: none; } }
</style>
