---
/**
 * The researcher's benchmark section: what was run, the bar check by check for each model, speed and cost, and the
 * same checks by kind of question. All from research.json (lib/research.ts); nothing is typed here. Rows are a grid,
 * not a table: on a phone a row's label takes the full width and its values sit under it, so nothing is clipped.
 */
import { Disclosure, Icon } from './ui'
import BenchFreshness from './BenchFreshness.astro'
import { RESEARCH, barRows, factRows, kindName, laterRows, modelName, share, totals } from '../lib/research'
import { longDate } from '../lib/bench'
const t = totals()
const runs = RESEARCH.runs
const names = runs.map((r) => modelName(r.model))
const missed = runs.map((r) => r.bar.filter((b) => b.met === false).length)
const measured = runs.map((r) => r.bar.filter((b) => b.met !== null).length)
const kinds = Object.keys(runs[0].by_kind)
const mark = (met: boolean | null) => (met === true ? 'met' : met === false ? 'not met' : '')
---
<p class="br-verdict"><strong>{names.map((n, i) => `${n} does not meet ${missed[i]} of the ${measured[i]} checks measured today`).join('; ')}.</strong> This is the "before" point: a starting point, not a ranking of the two models.</p>

<p>This is the researcher as it is today. {t.scenarios} questions on {t.documents} invented documents ({t.pages.toLocaleString('en-US')} pages) in {RESEARCH.sets.length} sets. Each question was asked {t.passes} times: {t.answers} answers per model. Code checks scored every answer; no model judged them. The bar is the target for each check, measured on {RESEARCH.bar_measured_on}.</p>

<BenchFreshness date={t.date} model={names.join(' and ')} what="The researcher's benchmark" />

<div class="br not-content" role="table" aria-label="The researcher's bar, check by check">
  <div class="br-row br-head" role="row"><span role="columnheader">Check</span>{names.map((n) => <span role="columnheader">{n}</span>)}<span role="columnheader">The bar</span></div>
  {barRows().map((r) => (
    <div class="br-row" role="row">
      <span class="br-label" role="rowheader">{r.label}</span>
      {r.cells.map((c, i) => <span class="br-cell" role="cell" data-met={c.met === null ? undefined : String(c.met)}><small>{names[i]}</small><b>{c.text}</b>{mark(c.met) && <em><Icon name={c.met ? 'check' : 'close'} />{mark(c.met)}</em>}</span>)}
      <span class="br-bar" role="cell"><small>The bar</small>{r.bar}</span>
    </div>
  ))}
  {factRows().map((r) => (
    <div class="br-row" role="row">
      <span class="br-label" role="rowheader">{r.label}</span>
      {r.cells.map((c, i) => <span class="br-cell" role="cell"><small>{names[i]}</small><b>{c.text}</b></span>)}
      <span class="br-bar" role="cell"><small>The bar</small>{r.bar || 'none'}</span>
    </div>
  ))}
</div>

<ul>
  <li><strong>"A number that is not in the passage they cite"</strong> is a strict check. On today's researcher it is mostly a figure taken from a document it read but did not cite, not a made-up figure.</li>
  <li><strong>Two passages that disagree</strong> is based on {runs[0].contradictions.found + runs[0].contradictions.missed} answers per model: too few to compare.</li>
</ul>

<Disclosure summary={`${laterRows().length} checks not measured yet`} panel>
  <p>Today's researcher does not report the time to its first word, or whether it chose a short or a long answer. These checks come with the new researcher:</p>
  <ul>{laterRows().map((r) => <li>{r.label}: {r.bar}</li>)}</ul>
</Disclosure>

<p>{RESEARCH.note}</p>

<Disclosure summary="By kind of question: required points covered" panel>
  <div class="br br-kinds not-content" role="table" aria-label="Coverage by kind of question">
    <div class="br-row br-head" role="row"><span role="columnheader">Kind of question</span>{names.map((n) => <span role="columnheader">{n}</span>)}<span role="columnheader">Answers</span></div>
    {kinds.map((k) => (
      <div class="br-row" role="row">
        <span class="br-label" role="rowheader">{kindName(k)}</span>
        {runs.map((r, i) => <span class="br-cell" role="cell"><small>{names[i]}</small><b>{r.by_kind[k]?.coverage == null ? `${share(r.by_kind[k]?.passed ?? 0)} right` : share(r.by_kind[k].coverage!)}</b></span>)}
        <span class="br-bar" role="cell"><small>Answers</small>{runs[0].by_kind[k].answers}</span>
      </div>
    ))}
  </div>
</Disclosure>

<p>Cost: at the prices checked on {runs.map((r, i) => r.prices ? `${longDate(r.prices.checked)} for ${names[i]}` : '').filter(Boolean).join(' and ')}. To run it again:</p>
<ul>{runs.map((r, i) => <li>{names[i]} (code <code>{r.commit}</code>): <code>{r.command}</code></li>)}</ul>

<style is:global>
  /* layout only; the type and colours are the design system's tokens */
  .br { margin: 1rem 0 1.5rem; font-size: var(--fg-fs-sub); }
  .br-row { display: grid; grid-template-columns: minmax(0, 2.2fr) repeat(2, minmax(0, 1fr)) minmax(0, 1fr); gap: 4px 16px; padding: 10px 0; border-bottom: 1px solid var(--fg-line); align-items: baseline; }
  .br-head { font-weight: 600; color: var(--fg-ink-2); font-size: var(--fg-fs-footnote); }
  .br-label { color: var(--fg-ink); }
  .br-cell { display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; font-variant-numeric: tabular-nums; }
  .br-cell b { font-weight: 600; color: var(--fg-ink); }
  .br-cell em { display: inline-flex; align-items: center; gap: 4px; font-style: normal; font-size: var(--fg-fs-footnote); font-weight: 600; color: var(--fg-ink); }
  .br-cell em svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .br-cell[data-met='true'] em { color: var(--fg-ok); font-weight: 400; }
  .br-verdict { font-size: var(--fg-fs-headline); line-height: 1.4; }
  .br-bar { color: var(--fg-ink-2); font-variant-numeric: tabular-nums; }
  .br small { display: none; font-size: var(--fg-fs-footnote); color: var(--fg-ink-3); }
  @media (max-width: 50rem) {
    .br-head { display: none; }
    .br-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .br-label { grid-column: 1 / -1; font-weight: 600; }
    .br small { display: block; flex-basis: 100%; }
    .br-bar small { display: block; }
  }
</style>
