---
/**
 * The researcher's demo: pick a document set, ask one of the hard questions, read the answer with its sources
 * (document, section, page). Until the live endpoint exists it replays answers recorded in QA's runs
 * (src/data/research-demo.json, written from those runs, never typed) through the real <agui-chat>: the text, then
 * the shipped `sources` chips. The documents of the set are listed beside the chat and the pages an answer used
 * light up. With no recorded answers yet the page says so; nothing is invented.
 */
import { Badge, ChipGroup, Disclosure, Row, Rows, Segmented } from './ui'
import data from '../data/research-demo.json'
import { longDate } from '../lib/bench'
import { RESEARCH, kindName } from '../lib/research'

interface Source { document: string; path?: string; page?: number; quote?: string }
interface Answer { text: string; sources?: Source[]; seconds?: number; cost_usd?: number; depth?: string }
interface Question { id: string; set: string; question: string; kind?: string; answers: Record<string, Answer> }
interface DocSet { id: string; name: string; about?: string; documents: { id: string; title: string; pages?: number }[] }
const d = data as { recorded: string | null; models: Record<string, string>; sets: DocSet[]; questions: Question[] }
const sets = d.sets.filter((s) => d.questions.some((q) => q.set === s.id))
const models = Object.entries(d.models).filter(([id]) => d.questions.some((q) => q.answers[id]))
const ready = sets.length > 0 && models.length > 0 && !!d.recorded
const pages = (s: DocSet) => s.documents.reduce((n, x) => n + (x.pages ?? 0), 0)
const FIRST = 4   // questions shown at once; the rest are one tap away
const of = (id: string) => d.questions.filter((q) => q.set === id)
// the chat does not draw Markdown tables yet: an answer with one is not offered (counted on the page, never edited)
const hasTable = (t: string) => /^\s*\|?\s*:?-{3,}/m.test(t)
const withTables = d.questions.reduce((n, q) => n + Object.values(q.answers).filter((a) => hasTable(a.text)).length, 0)
---
{ready ? (
  <div class="rd ui-tile ui-tile--lg not-content" data-rd data-recorded={longDate(d.recorded!.slice(0, 10))}>
    <script type="application/json" data-rd-data set:html={JSON.stringify({ models: d.models, sets, questions: d.questions })} />
    <div class="rd-controls">
      <ChipGroup label="Document set" options={sets.map((s) => ({ value: s.id, label: s.name }))} data-set />
      {models.length > 1 && <Segmented label="Answered by" options={models.map(([id, name]) => [id, name] as const)} data-model />}
    </div>
    <p class="rd-rec"><Badge>Recorded</Badge> <span data-rec-line></span></p>
    <div class="rd-grid">
      <div class="rd-qs">
        <p class="rd-cap">Hard questions to try</p>
        {sets.map((s, i) => (
          <div class="rd-qlist" data-for={s.id} hidden={i > 0}>
            <Rows label="Questions to try">{of(s.id).slice(0, FIRST).map((q) => <Row caption={kindName(q.kind ?? '')} chevron={false} data-q={q.id}>{q.question}</Row>)}</Rows>
            {of(s.id).length > FIRST && (
              <Disclosure summary={`${of(s.id).length - FIRST} more questions`}>
                <div class="rd-more"><Rows label="More questions">{of(s.id).slice(FIRST).map((q) => <Row caption={kindName(q.kind ?? '')} chevron={false} data-q={q.id}>{q.question}</Row>)}</Rows></div>
              </Disclosure>
            )}
          </div>
        ))}
      </div>
      <div class="rd-chat">
        <agui-chat mode="inline" persist-thread="off" attach="off" quick-replies="off" voice="off" title="Researcher" subtitle="Recorded answers"></agui-chat>
      </div>
    </div>
    <div class="rd-verdict" data-verdict hidden aria-live="polite">
      <p class="rd-cap">The benchmark's checks on this answer</p>
      <p class="rd-v" data-v></p>
      <ul data-v-why></ul>
      <p class="rd-vnote">The checks look at required points, sources, numbers, length and shape. Passing them is not the same as being correct, and an answer that misses one can still be useful.</p>
    </div>
    <div class="rd-docs" aria-live="polite">
      {sets.map((s, i) => (
        <div class="rd-set" data-for={s.id} hidden={i > 0}>
          <p class="rd-cap">Sources of this answer</p>
          <p class="rd-none" data-none>Pick a question. The documents its answer cites appear here, out of {s.documents.length}{pages(s) ? ` (${pages(s).toLocaleString('en-US')} pages)` : ''} in this set.</p>
          <p class="rd-none" data-nosrc hidden>This answer cites no document.</p>
          <ul>{s.documents.map((x) => <li data-doc={x.id} hidden><span class="rd-doc-t">{x.title}</span><span class="rd-doc-u" data-used></span></li>)}</ul>
          <Disclosure summary={`All ${s.documents.length} documents in this set`}>
            {s.about && <p class="rd-about">{s.about}</p>}
            <p class="rd-all">{s.documents.map((x) => x.title).join(' · ')}</p>
          </Disclosure>
        </div>
      ))}
    </div>
    {withTables > 0 && <p class="rd-note">{withTables} recorded answer{withTables === 1 ? ' has' : 's have'} a table, which the chat does not draw yet; {withTables === 1 ? 'it is' : 'they are'} not offered here.</p>}
  </div>
) : (
  <div class="rd ui-tile ui-tile--lg not-content">
    <p class="rd-empty"><Badge>Being prepared</Badge> The recorded answers are not here yet. Below are the document sets and the questions the researcher is tested on; each will play its real answer, with sources, as soon as the answers are in.</p>
    {RESEARCH.sets.map((s) => (
      <section class="rd-plain" aria-labelledby={`rd-${s.id}`}>
        <h3 id={`rd-${s.id}`}>{s.title}</h3>
        <p class="rd-cap">{s.documents} documents · {s.pages.toLocaleString('en-US')} pages</p>
        <ul>{RESEARCH.questions.filter((q) => q.set === s.id).map((q) => <li><span>{q.question}</span><small>{kindName(q.kind)} · {q.depth === 'deep' ? 'a long answer' : 'a short answer'}</small></li>)}</ul>
      </section>
    ))}
  </div>
)}

<script>
  import '../../../packages/agui-chat/src/index'
  import { formguide } from '../../../packages/agui-chat/src/formguide/index'
  import type { AguiChatElement } from '../../../packages/agui-chat/src/element'
  import type { AguiEvent, RunAgentInput } from '../../../packages/agui-chat/src/types'

  interface Source { document: string; path?: string; page?: number; quote?: string }
  interface Answer { text: string; sources?: Source[]; seconds?: number; cost_usd?: number; depth?: string; passed?: boolean; missed?: string[] }
  interface Question { id: string; set: string; question: string; answers: Record<string, Answer> }
  interface DocSet { id: string; name: string; documents: { id: string; title: string }[] }
  const nid = (p: string) => `${p}_${Math.random().toString(36).slice(2, 10)}`
  const NOT_RECORDED = 'This question has no recorded answer. Pick one from the list.'
  const hasTable = (t: string) => /^\s*\|?\s*:?-{3,}/m.test(t)

  for (const root of document.querySelectorAll<HTMLElement>('[data-rd]')) {
    const data = JSON.parse(root.querySelector('[data-rd-data]')!.textContent!) as { models: Record<string, string>; sets: DocSet[]; questions: Question[] }
    const chat = root.querySelector('agui-chat') as AguiChatElement
    let set = data.sets[0].id
    let model = Object.keys(data.models).find((m) => data.questions.some((q) => q.answers[m]))!
    const docsOf = () => data.sets.find((s) => s.id === set)!.documents
    const playable = (q: Question | undefined, m = model) => { const a = q?.answers[m]; return a && !hasTable(a.text) ? a : undefined }
    const answerOf = (text: string) => playable(data.questions.find((q) => q.set === set && q.question === text.trim()))
    let lastQ: string | null = null   // the question on screen: replayed when the model changes, so two models can be compared

    const clearUsed = () => {
      root.querySelectorAll<HTMLElement>('[data-doc]').forEach((li) => { li.hidden = true; li.querySelector('[data-used]')!.textContent = '' })
      root.querySelectorAll<HTMLElement>('[data-none]').forEach((p) => { p.hidden = false })
      root.querySelectorAll<HTMLElement>('[data-nosrc]').forEach((p) => { p.hidden = true })
    }
    const markUsed = (sources: Source[]) => {
      clearUsed()
      const by = new Map<string, string[]>()
      for (const s of sources) {
        const where = [s.path?.replace(/\s*>\s*/g, ' \u203a '), s.page ? `p. ${s.page}` : ''].filter(Boolean).join(', ')
        by.set(s.document, [...(by.get(s.document) ?? []), ...(where ? [where] : [])])
      }
      const box = root.querySelector<HTMLElement>('.rd-set:not([hidden])')
      for (const [doc, wheres] of by) {
        const li = box?.querySelector<HTMLElement>(`[data-doc="${CSS.escape(doc)}"]`)
        if (!li) continue
        li.hidden = false
        li.querySelector('[data-used]')!.textContent = [...new Set(wheres)].join(' \u00b7 ')
      }
      const none = box?.querySelector<HTMLElement>('[data-none]'), nosrc = box?.querySelector<HTMLElement>('[data-nosrc]')
      if (none) none.hidden = true
      if (nosrc) nosrc.hidden = by.size > 0
    }
    const verdict = (a?: Answer) => {
      const box = root.querySelector<HTMLElement>('[data-verdict]')!
      box.hidden = typeof a?.passed !== 'boolean'
      if (box.hidden) return
      box.dataset.passed = String(a!.passed)
      box.querySelector('[data-v]')!.textContent = a!.passed ? 'Passed every check.' : `Did not pass ${a!.missed?.length === 1 ? 'one check' : `${a!.missed?.length ?? 'some'} checks`}:`
      box.querySelector('[data-v-why]')!.replaceChildren(...(a!.passed ? [] : (a!.missed ?? []).map((w) => Object.assign(document.createElement('li'), { textContent: w }))))
    }
    const recLine = (a?: Answer) => {
      const bits = [`${root.dataset.recorded}`, data.models[model]]
      if (a?.depth) bits.push(a.depth === 'deep' ? 'long answer' : 'short answer')
      if (typeof a?.seconds === 'number') bits.push(`${a.seconds.toFixed(1)} s`)
      if (typeof a?.cost_usd === 'number') bits.push(`$${a.cost_usd.toFixed(3)}`)
      root.querySelector('[data-rec-line]')!.textContent = bits.join(' · ')
    }

    chat.agent = {
      run(input: RunAgentInput) {
        const last = [...(input.messages ?? [])].reverse().find((m) => m.role === 'user')
        const a = answerOf(String(last?.content ?? ''))
        const messageId = nid('m')
        const title = (id: string) => docsOf().find((x) => x.id === id)?.title ?? id
        const events: AguiEvent[] = [
          { type: 'RUN_STARTED', threadId: input.threadId, runId: input.runId } as AguiEvent,
          { type: 'TEXT_MESSAGE_START', messageId, role: 'assistant' } as AguiEvent,
          { type: 'TEXT_MESSAGE_CONTENT', messageId, delta: a ? a.text : NOT_RECORDED } as AguiEvent,
          { type: 'TEXT_MESSAGE_END', messageId } as AguiEvent,
          ...(a?.sources?.length ? [{ type: 'CUSTOM', name: 'sources', value: { items: a.sources.map((s) => ({
            title: title(s.document), section: [s.path?.replace(/\s*>\s*/g, ' › '), s.page ? `p. ${s.page}` : ''].filter(Boolean).join(' · ') || undefined, quote: s.quote })) } } as AguiEvent] : []),
          { type: 'RUN_FINISHED', threadId: input.threadId, runId: input.runId } as AguiEvent,
        ]
        return {
          subscribe: (o: { next(e: AguiEvent): void; error(e: unknown): void; complete(): void }) => {
            let stopped = false
            void (async () => {
              for (const e of events) {
                if (stopped) return
                await new Promise((r) => setTimeout(r, 120))
                o.next(e)
              }
              if (!stopped) { if (a) { markUsed(a.sources ?? []); recLine(a); verdict(a) } o.complete() }
            })()
            return { unsubscribe: () => { stopped = true } }
          },
        }
      },
    }
    chat.use(formguide({
      getState: () => ({ config: { props: {}, state: {} }, jsx_hash: 'recorded', form_id: set }),
      applyChanges: async () => ({ props: {}, state: {} }),
      highlight: false,
    }))

    chat.options = { intro: 'Pick a question from the list to read the recorded answer and its sources.' }
    const ask = (id: string, reveal = true) => {
      const q = data.questions.find((x) => x.id === id)
      if (!q || !playable(q)) return
      lastQ = id
      root.querySelectorAll<HTMLElement>('[data-q]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.q === id)))
      chat.stop(); void chat.send(q.question)
      const box = chat.getBoundingClientRect()   // on a phone the chat is below the questions: bring it into view
      if (reveal && (box.top > innerHeight * 0.6 || box.bottom < 0)) chat.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })
    }
    const show = (replay = false) => {
      root.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => { el.hidden = el.dataset.for !== set })
      // a question this model has no answer the chat can draw for is not offered
      root.querySelectorAll<HTMLElement>('[data-q]').forEach((b) => { b.hidden = !playable(data.questions.find((q) => q.id === b.dataset.q)) })
      chat.stop(); chat.reset(); clearUsed(); recLine(); verdict()
      if (replay && lastQ) ask(lastQ, false); else { lastQ = null; root.querySelectorAll<HTMLElement>('[data-q]').forEach((b) => b.setAttribute('aria-pressed', 'false')) }
    }
    root.querySelector('[data-set]')!.addEventListener('ui-change', (e) => { set = (e as CustomEvent<{ value: string }>).detail.value; show() })
    root.querySelector('[data-model]')?.addEventListener('ui-change', (e) => { model = (e as CustomEvent<{ value: string }>).detail.value; show(true) })
    root.querySelectorAll<HTMLElement>('[data-q]').forEach((b) => b.addEventListener('click', () => ask(b.dataset.q!)))
    const scheme = () => chat.setAttribute('scheme', document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
    scheme()
    new MutationObserver(scheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    show()
  }
</script>

<style is:global>
  /* layout only: the controls are primitives from ./ui, the outer box is a large Tile */
  .rd { margin: 1.5rem 0 2rem; padding: 16px; display: flex; flex-direction: column; gap: 16px; }
  .rd-controls { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; }
  .rd-rec { margin: 0; display: flex; align-items: flex-start; gap: 8px; font-size: var(--fg-fs-footnote); line-height: 1.5; color: var(--fg-ink-2); font-variant-numeric: tabular-nums; }
  .rd-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 16px; align-items: start; }
  .rd-cap { margin: 0 0 8px; font: 600 var(--fg-fs-footnote)/1.3 var(--sl-font); color: var(--fg-ink-2); }
  .rd-about, .rd-all, .rd-none, .rd-note { margin: 0 0 8px; font-size: var(--fg-fs-sub); color: var(--fg-ink-2); }
  .rd-note { margin: 0; }
  .rd-verdict[hidden] { display: none; }
  .rd-v { margin: 0 0 4px; font: 600 var(--fg-fs-callout)/1.4 var(--sl-font); color: var(--fg-ink); }
  .rd-verdict[data-passed='true'] .rd-v { color: var(--fg-ok); }
  .rd-verdict ul { margin: 0 0 8px; padding-left: 1.2em; font-size: var(--fg-fs-sub); color: var(--fg-ink); }
  .rd-verdict ul:empty { display: none; }
  .rd-vnote { margin: 0; font-size: var(--fg-fs-footnote); color: var(--fg-ink-3); }
  .rd-qs { min-width: 0; }
  .rd-docs ul { list-style: none; margin: 0 0 8px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .rd-docs li { display: flex; flex-direction: column; gap: 2px; padding: 12px; border-radius: var(--fg-r-ctl); background: var(--fg-surface); border: 1px solid var(--fg-accent); }
  .rd-docs li[hidden], .rd-none[hidden] { display: none; }
  .rd-doc-t { font: 600 var(--fg-fs-callout)/1.3 var(--sl-font); color: var(--fg-ink); overflow-wrap: anywhere; }
  .rd-doc-u { font-size: var(--fg-fs-footnote); color: var(--fg-ink-2); }
  .rd-chat { height: 520px; min-width: 0; position: sticky; top: 5rem; }   /* stays beside a long list of questions */
  .rd-chat agui-chat::part(composer) { display: none; }   /* a recorded page: nothing to type */
  .rd-chat agui-chat { display: block; height: 100%; --agui-accent: var(--sl-color-accent); --agui-on-accent: #fff; --agui-link: var(--sl-color-accent); }
  :root[data-theme='dark'] .rd-chat agui-chat { --agui-accent: var(--sl-color-accent-high); --agui-on-accent: var(--sl-color-black); --agui-link: var(--sl-color-accent-high); }
  .rd-qlist, .rd-more { display: flex; flex-direction: column; align-items: stretch; gap: 8px; }
  .rd-more { margin-top: 8px; }
  .rd-qlist[hidden], .rd-set[hidden] { display: none; }
  .rd-empty { margin: 0; color: var(--fg-ink-2); }
  .rd-plain h3 { margin: 0 0 4px; font: 600 var(--fg-fs-headline)/1.3 var(--sl-font); color: var(--fg-ink); }
  .rd-plain ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .rd-plain li { display: flex; flex-direction: column; gap: 2px; padding: 10px 0; border-top: 1px solid var(--fg-line); color: var(--fg-ink); }
  .rd-plain li small { font-size: var(--fg-fs-footnote); color: var(--fg-ink-3); }
  @media (max-width: 50rem) {
    .rd-grid { grid-template-columns: minmax(0, 1fr); }
    .rd-rec { min-height: 3em; }   /* two lines kept: nothing below moves when the seconds and the cost arrive */
    .rd-chat { height: 480px; scroll-margin-top: 120px; position: static; }
  }
</style>
