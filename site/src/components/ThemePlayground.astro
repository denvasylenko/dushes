---
/**
 * The theme playground: pick an accent, radii, a font and the scheme, and watch a real <agui-chat> (with a
 * field-change card from the gallery) change as you drag. The defineTheme() call for what you see is below it.
 */
import { Button, ChipGroup, CodePanel, Range, Segmented, Swatches } from './ui'

const ACCENTS = ['#0a84ff', '#30a46c', '#ff9f0a', '#ff375f', '#bf5af2', '#1c1c1e']
const FONTS = [
  ['System', 'system-ui, -apple-system, "Segoe UI", sans-serif'],
  ['Rounded', 'ui-rounded, "SF Pro Rounded", system-ui, sans-serif'],
  ['Serif', 'ui-serif, Georgia, serif'],
  ['Mono', 'ui-monospace, SFMono-Regular, Menlo, monospace'],
]
---
<div class="tp ui-tile ui-tile--lg not-content" data-tp>
  <div class="tp-controls">
    <Swatches label="Accent" colors={ACCENTS} any data-accent />
    <Segmented label="Scheme" options={[['light', 'Light'], ['dark', 'Dark']]} value="dark" data-scheme />
    <div class="tp-ranges">
      <Range id="tp-radius" label="Corners" min={0} max={24} value={14} unit=" px" data-token="radius" />
      <Range id="tp-card" label="Cards" min={0} max={28} value={14} unit=" px" data-token="card-radius" />
      <Range id="tp-bubble" label="Bubbles" min={4} max={26} value={18} unit=" px" data-token="bubble-radius" />
    </div>
    <ChipGroup label="Font" options={FONTS.map(([name, stack]) => ({ value: stack, label: name, style: `font-family:${stack}` }))} data-font />
    <Button variant="plain" class="tp-reset" data-reset>Reset</Button>
  </div>

  <div class="tp-stage">
    <agui-chat mode="inline" persist-thread="off" attach="off" typing="plain" lang="en" title="Loan assistant" subtitle="Your theme, live"></agui-chat>
  </div>

  <CodePanel class="tp-code" label="theme.js" data-code />
</div>

<script>
  import '../../../packages/agui-chat/src/index'
  import { formguide } from '../../../packages/agui-chat/src/formguide/index'
  import type { AguiChatElement } from '../../../packages/agui-chat/src/element'
  import { SPECIMENS, playSpecimen } from '../demo/gallery'
  import { setChoice, syncRange } from './ui/ui'

  for (const root of document.querySelectorAll<HTMLElement>('[data-tp]')) {
    const chat = root.querySelector('agui-chat') as AguiChatElement
    const code = root.querySelector<HTMLElement>('[data-code] code')!
    const groups = {
      accent: root.querySelector<HTMLElement>('[data-accent]')!,
      font: root.querySelector<HTMLElement>('[data-font]')!,
      scheme: root.querySelector<HTMLElement>('[data-scheme]')!,
    }
    const DEFAULT = { accent: '#0a84ff', radius: 14, 'card-radius': 14, 'bubble-radius': 18, font: 'system-ui, -apple-system, "Segoe UI", sans-serif', scheme: 'dark' }
    const t = { ...DEFAULT }

    // readable text on the accent: black on light colours, white on dark ones
    const onAccent = (hex: string) => {
      const n = parseInt(hex.slice(1), 16), r = n >> 16, g = (n >> 8) & 255, b = n & 255
      return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.62 ? '#000000' : '#ffffff'
    }
    const apply = () => {
      const s = chat.style
      s.setProperty('--agui-accent', t.accent)
      s.setProperty('--agui-on-accent', onAccent(t.accent))
      s.setProperty('--agui-link', t.accent)
      s.setProperty('--agui-radius', `${t.radius}px`)
      s.setProperty('--agui-radius-sm', `${Math.max(0, Math.round(t.radius * 0.7))}px`)
      s.setProperty('--agui-card-radius', `${t['card-radius']}px`)
      s.setProperty('--agui-bubble-radius', `${t['bubble-radius']}px`)
      s.setProperty('--agui-font', t.font)
      chat.setAttribute('scheme', t.scheme)
      setChoice(groups.accent, t.accent)
      setChoice(groups.font, t.font)
      setChoice(groups.scheme, t.scheme)
      code.textContent = `import { defineTheme } from '@formguide/agui-chat'

defineTheme('mine', {
  tokens: {
    accent: '${t.accent}', 'on-accent': '${onAccent(t.accent)}', link: '${t.accent}',
    radius: '${t.radius}px', 'card-radius': '${t['card-radius']}px', 'bubble-radius': '${t['bubble-radius']}px',
    font: '${t.font.replace(/'/g, "\\'")}',
  },
})

// <agui-chat theme="mine" scheme="${t.scheme}"></agui-chat>`
    }

    // the controls are primitives: choice groups fire ui-change, sliders fire input (the primitive keeps their track and value)
    groups.accent.addEventListener('ui-change', (e) => { t.accent = (e as CustomEvent<{ value: string }>).detail.value; apply() })
    groups.font.addEventListener('ui-change', (e) => { t.font = (e as CustomEvent<{ value: string }>).detail.value; apply() })
    groups.scheme.addEventListener('ui-change', (e) => { t.scheme = (e as CustomEvent<{ value: string }>).detail.value; apply() })
    root.querySelector<HTMLInputElement>('[data-ui-any]')!.addEventListener('input', (e) => { t.accent = (e.target as HTMLInputElement).value; apply() })
    root.querySelectorAll<HTMLInputElement>('[data-token]').forEach((r) => r.addEventListener('input', () => {
      (t as Record<string, unknown>)[r.dataset.token!] = Number(r.value)
      apply()
    }))
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      Object.assign(t, DEFAULT)
      root.querySelectorAll<HTMLInputElement>('[data-token]').forEach((r) => { r.value = String(t[r.dataset.token as 'radius']); syncRange(r) })
      apply()
    })
    apply()

    const s = SPECIMENS.find((x) => x.id === 'set-fields')!
    const start = () => { playSpecimen(chat, s, formguide) }
    'IntersectionObserver' in window
      ? new IntersectionObserver((es, io) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start() } }).observe(root)
      : start()
  }
</script>

<style is:global>
  /* layout only: the controls are primitives from ./ui, the outer box is a large Tile */
  .tp { display: grid; grid-template-columns: 17rem minmax(0, 1fr); grid-template-areas: 'controls stage' 'code code'; gap: 16px; margin: 1.5rem 0 2rem; padding: 16px; }
  .tp-controls { grid-area: controls; display: flex; flex-direction: column; gap: 24px; padding: 8px 6px; }
  .tp-ranges { display: flex; flex-direction: column; gap: 12px; }
  .tp-reset { align-self: flex-start; }
  .tp-stage { grid-area: stage; height: 540px; border-radius: var(--fg-r-panel); overflow: hidden; }
  .tp-stage agui-chat { display: block; height: 100%; }
  .tp-code { grid-area: code; }
  @media (max-width: 50rem) {
    .tp { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'stage' 'controls' 'code'; padding: 12px; }
    .tp-stage { height: 480px; }
  }
</style>
