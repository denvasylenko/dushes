---
/**
 * The page title with a one-line summary under it (the page's description) and the page actions:
 * Copy page (its Markdown), Open in Claude, Open in ChatGPT. Replaces Starlight's PageTitle.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Button, CopyButton } from './ui';
const { entry } = Astro.locals.starlightRoute;
const desc = entry.data.description;
// pages with their own header: the landing (a hero) and the card gallery
const custom = entry.id === 'frontend/card-gallery';
const splash = entry.data.template === 'splash' || !!entry.data.hero || custom;
const isSpec = entry.id.startsWith('reference/specifications/') && entry.id !== 'reference/specifications';
---
{!custom && <Default />}
{!splash && (
  <>
    {desc && !isSpec && <p class="pt-lead">{desc}</p>}
    <div class="pt-actions" data-page-actions data-pagefind-ignore>
      <CopyButton label="Copy page" auto={false} data-copy-page />
      <Button size="sm" href="https://claude.ai/new" target="_blank" rel="noopener" data-open="claude">Open in Claude</Button>
      <Button size="sm" href="https://chatgpt.com/" target="_blank" rel="noopener" data-open="chatgpt">Open in ChatGPT</Button>
    </div>
  </>
)}

<script>
  import { copyText } from './ui/ui'
  const mdUrl = () => {
    const p = location.pathname.replace(/\/$/, '')
    const base = import.meta.env.BASE_URL.replace(/\/$/, '')
    return location.origin + (p === base ? `${base}/index` : p) + '.md'
  }
  const ask = () => `Read ${mdUrl()} (Dushes documentation; the whole site is at ${location.origin}${import.meta.env.BASE_URL.replace(/\/?$/, '/')}llms.txt) and help me with it.`
  for (const box of document.querySelectorAll<HTMLElement>('[data-page-actions]')) {
    box.querySelector<HTMLAnchorElement>('[data-open="claude"]')!.href = `https://claude.ai/new?q=${encodeURIComponent(ask())}`
    box.querySelector<HTMLAnchorElement>('[data-open="chatgpt"]')!.href = `https://chatgpt.com/?q=${encodeURIComponent(ask())}`
    const btn = box.querySelector<HTMLButtonElement>('[data-copy-page]')!
    btn.dataset.fail = 'Could not copy'
    btn.addEventListener('click', () => { void copyText(btn, async () => (await fetch(mdUrl())).text()) })
  }
</script>

<style>
  .pt-lead { font-size: var(--sl-text-lg); line-height: 1.5; color: var(--fg-ink-2); margin: .5rem 0 0; max-width: 60ch; text-wrap: pretty; }
  .pt-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1rem; }
</style>
