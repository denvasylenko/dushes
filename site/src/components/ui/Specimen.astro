---
/**
 * Specimen: the stage a live example sits on (the design-system page). A caption names what is shown;
 * `row` lays the examples out in a wrapping row, `col` in a column. Theme switches marked [data-ds-theme]
 * set the whole site's theme, so every specimen can be seen light and dark.
 */
interface Props { caption?: string; layout?: 'row' | 'col'; class?: string }
const { caption, layout = 'row', class: cls } = Astro.props
---
<figure class:list={['ui-specimen', 'not-content', cls]}>
  <div class:list={['ui-specimen-stage', `is-${layout}`]}><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // a Segmented control on the page that switches the site's theme (through Starlight's own select)
  document.querySelectorAll<HTMLElement>('[data-ds-theme]').forEach((g) => {
    const select = () => document.querySelector<HTMLSelectElement>('starlight-theme-select select')
    const now = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'
    g.querySelectorAll<HTMLElement>('[role="radio"]').forEach((r) => { r.setAttribute('aria-checked', String(r.dataset.value === now)); r.tabIndex = r.dataset.value === now ? 0 : -1 })
    g.addEventListener('ui-change', (e) => {
      const v = (e as CustomEvent<{ value: string }>).detail.value
      const s = select()
      if (s) { s.value = v; s.dispatchEvent(new Event('change')) } else document.documentElement.dataset.theme = v
    })
  })
</script>

<style is:global>
  .ui-specimen { margin: 1.25rem 0 0; }
  .ui-specimen-stage {
    display: flex; gap: 12px; padding: 28px 24px; border-radius: var(--fg-r-tile);
    background: radial-gradient(120% 120% at 50% 0%, var(--fg-accent-soft), transparent 55%), var(--fg-surface); box-shadow: inset 0 0 0 1px var(--fg-line);
  }
  .ui-specimen-stage.is-row { flex-wrap: wrap; align-items: center; }
  .ui-specimen-stage.is-col { flex-direction: column; align-items: stretch; }
  .ui-specimen-stage.is-row > .ui-tile { flex: 1; min-width: 12rem; }
  .ui-specimen-stage .ui-pop--static { width: 18rem; }
  .ui-specimen-narrow { max-width: 18rem; display: flex; flex-direction: column; gap: 20px; }
  .ui-specimen figcaption { margin-top: 8px; font-size: var(--fg-fs-footnote); color: var(--fg-ink-3); text-align: center; }
  .ui-specimen + .expressive-code, .ui-specimen + * .expressive-code { margin-top: 12px; }
  @media (max-width: 50rem) { .ui-specimen-stage { padding: 20px 16px; border-radius: var(--fg-r-panel); } }
</style>
