---
/**
 * The landing page's live demo: a real <agui-chat> and a real form. With PUBLIC_DEMO_AGENT_URL (the hosted /agent/run)
 * the chat talks to the real agent, limited per visitor; over the limit, or without the URL, a scripted in-browser agent
 * replays the events formguide's server would send, and nothing leaves the page.
 */
import { Badge, Button } from './ui';
const live = import.meta.env.PUBLIC_DEMO_URL as string | undefined;
const agentUrl = import.meta.env.PUBLIC_DEMO_AGENT_URL as string | undefined;
---
<div class="demo not-content" data-demo data-agent-url={agentUrl} data-live={agentUrl ? '' : undefined}>
  <div class="demo-bar">
    <span class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="demo-url">your-app.example/apply</span>
    <!-- which agent answers: shown by [data-live] on .demo (removed on a fallback to the replay) -->
    <span class="demo-mode" aria-live="polite">
      <Badge variant="ok" class="demo-live"><span class="ui-dot" aria-hidden="true"></span>Live</Badge>
      <Badge class="demo-rec">Recorded</Badge>
    </span>
    <Button variant="quiet" size="sm" data-reset>Start over</Button>
  </div>
  <div class="demo-grid">
    <div class="demo-form" data-form>
      <noscript><p class="demo-nojs">The live demo needs JavaScript. It shows the chat filling this form; see the <a href="get-started/quickstart/">quick start</a> to run the real agent.</p></noscript>
    </div>
    <div class="demo-chat">
      <agui-chat mode="inline" persist-thread="off" attach="off" title="Loan assistant" subtitle={agentUrl ? 'Live agent' : 'Replays recorded turns · no server'}></agui-chat>
    </div>
  </div>
  <p class="demo-cap">The real <code>&lt;agui-chat&gt;</code> widget and its form plugin. <span data-cap>{agentUrl ? 'Ask anything about the form.' : 'Only the agent is scripted: tap a suggestion.'}</span>{live && <> Try the real agents: <a href={live}>a big form</a> or <a href={`${live.replace(/\/?$/, '/')}site.html`}>a whole site</a>.</>}</p>
</div>

<script>
  import '../../../packages/agui-chat/src/index'
  import { formguide } from '../../../packages/agui-chat/src/formguide/index'
  import { mountForm } from '../demo/form'
  import { QUICKSTART, ScriptedAgent, STARTERS } from '../demo/agent'
  import { landingLayout, liveDemo } from '../demo/live'

  const REPLAY = 'Replays recorded turns · no server'
  const RECORDED = 'This is a recorded run.'

  for (const root of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const form = mountForm(root.querySelector<HTMLElement>('[data-form]')!)
    const chat = root.querySelector('agui-chat')!
    const agent = new ScriptedAgent(form)
    chat.agent = agent
    chat.options = { starters: STARTERS, intro: 'Ask about any field, or let me fill the form for you.' }
    const setCap = (t: string) => { const c = root.querySelector<HTMLElement>('[data-cap]'); if (c) c.textContent = t }
    let jsxHash: string | null = null
    const url = root.dataset.agentUrl
    if (url) void landingLayout(url).then((hash) => {   // the real agent only when the host knows the form
      if (!hash) { chat.setAttribute('subtitle', REPLAY); setCap(RECORDED); root.removeAttribute('data-live'); return }   // the host does not know the form: the replay, quietly
      jsxHash = hash
      const demo = liveDemo(url, agent, QUICKSTART, () => { chat.setAttribute('subtitle', REPLAY); setCap(RECORDED); root.removeAttribute('data-live') })
      chat.options = { transport: demo.transport }
    })
    chat.use(formguide({
      getState: () => ({ ...form.state(), ...(jsxHash ? { jsx_hash: jsxHash } : {}) }),
      applyChanges: (changes) => form.apply(changes),
      highlight: false,   // form.apply highlights the fields itself (also on Undo)
      onDirective: (d) => form.reveal(d),
      undoSeconds: 30,
    }))
    const scheme = () => chat.setAttribute('scheme', document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
    scheme()
    new MutationObserver(scheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
    root.querySelector('[data-reset]')!.addEventListener('click', () => { chat.stop(); chat.reset(); form.reset() })
  }
</script>

<style is:global>
  .demo { --r: 20px; margin: 2.5rem auto 0; max-width: 72rem; }
  .demo-bar, .demo-grid { background: var(--fg-surface); }
  .demo-bar {
    display: flex; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid var(--sl-color-hairline-light);
    border-bottom: 0; border-radius: var(--r) var(--r) 0 0;
  }
  .demo-dots { display: flex; gap: 6px; }
  .demo-dots i { width: 10px; height: 10px; border-radius: 999px; background: var(--sl-color-hairline-light); }
  .demo-url {
    flex: 1; min-width: 0; text-align: center; font: var(--sl-text-xs) var(--sl-font-mono); color: var(--sl-color-gray-3);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .demo-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); height: 600px;
    border: 1px solid var(--sl-color-hairline-light); border-radius: 0 0 var(--r) var(--r); overflow: hidden;
    box-shadow: 0 30px 80px -30px var(--fg-glow), 0 12px 32px -16px hsla(0, 0%, 0%, .25);
  }
  .demo-form { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid var(--sl-color-hairline-light); background: var(--sl-color-bg); }
  .demo-chat { min-height: 0; padding: 12px; }
  .demo-chat agui-chat { display: block; height: 100%; --agui-accent: var(--sl-color-accent); --agui-on-accent: #fff; --agui-link: var(--sl-color-accent); }
  :root[data-theme='dark'] .demo-chat agui-chat { --agui-accent: var(--sl-color-accent-high); --agui-on-accent: var(--sl-color-black); --agui-link: var(--sl-color-accent-high); }
  .demo-cap { text-align: center; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); margin: 14px 0 0; }
  .demo-nojs { padding: 24px; color: var(--sl-color-gray-2); }

  /* the demo form */
  .df-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 20px 24px 12px; }
  .df-title { font: 600 var(--sl-text-xl)/1.2 var(--fg-display); letter-spacing: -0.02em; color: var(--sl-color-white); }
  .df-progress { font: var(--sl-text-xs) var(--sl-font); color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; position: relative; padding-bottom: 6px; }
  .df-progress::after {
    content: ''; position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 6px; background: var(--sl-color-accent);
    width: calc(var(--p, 0) * 100%); transition: width .34s cubic-bezier(.2, .8, .2, 1);
  }
  /* the sections are the design system's tabs (.ui-tabs / .ui-tab); this only places the row */
  .df-tabs.ui-tabs { padding: 0 8px; border-bottom: 1px solid var(--fg-line); }
  .df-body { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 24px 24px; display: flex; flex-direction: column; gap: 16px; }
  .df-field { position: relative; display: flex; flex-direction: column; gap: 6px; border-radius: 14px; margin: -6px -8px; padding: 6px 8px; }
  /* Live / Recorded in the window bar */
  .demo-mode { display: inline-flex; margin-left: auto; }
  .demo-mode .ui-badge { gap: 6px; }
  .demo-mode .ui-dot { width: 6px; height: 6px; background: var(--fg-ok); }
  .demo:not([data-live]) .demo-live, .demo[data-live] .demo-rec { display: none; }
  .df-label { font: 500 var(--fg-fs-sub)/1.3 var(--sl-font); color: var(--fg-ink-2); }
  /* inputs on the same tokens as the design system's Select (src/demo/form.ts builds both) */
  .df-in {
    font: 400 16px/1.2 var(--sl-font); color: var(--fg-ink); background: var(--fg-surface); border: 1px solid var(--fg-line);
    border-radius: var(--fg-r-ctl); padding: 0 12px; min-height: 44px; width: 100%;
    transition: border-color var(--fg-dur-instant) var(--fg-ease);
  }
  .df-in::placeholder { color: var(--fg-ink-3); }
  @media (hover: hover) { .df-in:hover { border-color: var(--fg-ink-3); } }
  .df-in:focus-visible { outline: none; border-color: var(--fg-accent); box-shadow: 0 0 0 3px var(--fg-focus); }
  /* a currency inside the field, before the number */
  .df-affix { position: relative; display: flex; }
  .df-unit { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font: 400 16px/1 var(--sl-font); color: var(--fg-ink-2); pointer-events: none; }
  .df-affix .df-in { padding-left: 26px; }
  /* Employment (chips) and Term (segmented) are the design system's choice groups; Term fills the row */
  .df-field > .ui-seg { align-self: stretch; }
  .df-field > .ui-seg > button { flex: 1 1 0; }
  /* the filled and look-here fields: the widget's own highlight (@formguide/agui-chat/highlight), see form.ts */
  @media (prefers-reduced-motion: reduce) {
    .df-progress::after { transition: none; }
  }

  @media (max-width: 50rem) {
    .demo { --r: 14px; }
    .demo-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 560px; height: auto; }
    .demo-form { border-right: 0; border-bottom: 1px solid var(--sl-color-hairline-light); max-height: 360px; }
    .demo-chat { padding: 8px; }
    .df-head { padding: 16px 16px 10px; }
    .df-tabs.ui-tabs { padding: 0 4px; }
    .df-body { padding: 14px 16px 18px; }
  }
</style>
