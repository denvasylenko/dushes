---
/**
 * The landing page's first demo: Dushes on a whole site (Main Street, the demo's site.html). On a host that serves the
 * demo (PUBLIC_DEMO_URL) it is the real site in a frame, with the real agent; elsewhere, a tile that links to it.
 */
import { Button, Callout, Tile } from './ui';
const live = import.meta.env.PUBLIC_DEMO_URL as string | undefined;
const site = live ? `${live.replace(/\/?$/, '/')}site.html` : undefined;
---
{site ? (
  <div class="sd not-content">
    <div class="sd-bar">
      <span class="sd-url">main-street.example</span>
      <Button variant="quiet" size="sm" href={site} target="_blank" rel="noopener">Open in a new tab</Button>
    </div>
    <iframe class="sd-frame" src={site} title="Main Street: a whole site with Dushes" loading="lazy"></iframe>
    <p class="sd-cap">Main Street: three businesses on one site. Ask Dushes about any page, ask it to take you somewhere, or start an application: it hands over to the form's UI agent.</p>
  </div>
) : (
  <Tile class="sd not-content">
    <Callout title="Main Street: a whole site with Dushes">Three businesses on one site: Dushes answers about any page, takes you there, and hands over to a form's UI agent when you apply. It runs on the demo host.</Callout>
    <div><Button variant="filled" href="get-started/live-demo/">Open the live demo</Button></div>
  </Tile>
)}

<style>
  /* layout only: the controls are primitives from ./ui */
  .sd { margin: 1.5rem auto 0; max-width: 72rem; display: flex; flex-direction: column; gap: 12px; }
  .sd-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 14px;
    background: var(--fg-surface); border: 1px solid var(--fg-line); border-radius: var(--fg-r-panel);
  }
  .sd-url { color: var(--fg-ink-2); font-size: var(--fg-fs-footnote); }
  .sd-frame {
    width: 100%; height: 720px; border: 1px solid var(--fg-line); border-radius: var(--fg-r-panel); background: var(--fg-surface);
  }
  .sd-cap { color: var(--fg-ink-2); font-size: var(--fg-fs-footnote); margin: 0; }
  @media (max-width: 50rem) { .sd-frame { height: 640px; } }
</style>
