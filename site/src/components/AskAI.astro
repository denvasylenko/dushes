---
/**
 * "Ask AI": the project's own <agui-chat> connected to the docs assistant (backend/docs_ai), when the
 * site is built with PUBLIC_ASK_AI_URL. Without it the button offers the current page in Claude or ChatGPT,
 * and nothing is sent to any assistant server.
 */
const url = import.meta.env.PUBLIC_ASK_AI_URL as string | undefined;
---
<div class="ask" data-ask-ai={url ?? ''}>
  <button type="button" class="ask-btn" data-ask-open aria-haspopup={url ? 'dialog' : 'menu'}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z"/></svg>
    Ask AI
  </button>
  {!url && (
    <div class="ask-menu" role="menu" hidden data-ask-menu>
      <p>Ask about this page in your AI assistant:</p>
      <a role="menuitem" data-open="claude" href="https://claude.ai/new" target="_blank" rel="noopener">Open in Claude</a>
      <a role="menuitem" data-open="chatgpt" href="https://chatgpt.com/" target="_blank" rel="noopener">Open in ChatGPT</a>
    </div>
  )}
</div>

<script>
  const STARTERS = [
    'Connect formguide to my React form',
    'Use Azure OpenAI with a cheaper model for research',
    'What does a date question look like?',
    'What is jsx_hash?',
  ]
  const box = document.querySelector<HTMLElement>('[data-ask-ai]')
  const url = box?.dataset.askAi
  const btn = box?.querySelector<HTMLButtonElement>('[data-ask-open]')
  if (box && btn && url) {
    let chat: HTMLElementTagNameMap['agui-chat'] | null = null
    const make = async () => {
      if (chat) return chat
      await import('../../../packages/agui-chat/src/index')
      const { docs } = await import('../ask/docs')
      if (chat) return chat
      const el = document.createElement('agui-chat')
      el.setAttribute('url', url)
      el.setAttribute('mode', 'floating')
      el.setAttribute('persist-thread', 'off')
      el.setAttribute('attach', 'off')
      el.setAttribute('title', 'Ask the docs')
      el.setAttribute('subtitle', 'Answers from these pages, with code')
      el.setAttribute('theme', 'docs')
      el.className = 'ask-chat'
      document.body.appendChild(el)
      el.options = { starters: STARTERS, intro: 'Ask anything about formguide. Code comes straight from these pages.' }
      el.use(docs())
      const scheme = () => el.setAttribute('scheme', document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
      scheme()
      new MutationObserver(scheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      return (chat = el)
    }
    // the floating button (also on phones, where the header has no room) appears once the page is idle
    ;(window.requestIdleCallback ?? ((f: () => void) => setTimeout(f, 800)))(() => void make())
    // the header button toggles: a second tap closes the panel, like the panel's own close button
    btn.addEventListener('click', async () => {
      const c = await make()
      if (c.shadowRoot?.querySelector('.wrap')?.classList.contains('open')) c.close(); else c.open()
    })
  } else if (box && btn) {
    const menu = box.querySelector<HTMLElement>('[data-ask-menu]')!
    const md = () => {
      const p = location.pathname.replace(/\/$/, '')
      const base = import.meta.env.BASE_URL.replace(/\/$/, '')
      return location.origin + (p === base ? `${base}/index` : p) + '.md'
    }
    const q = () => encodeURIComponent(`Read ${md()} (formguide documentation) and help me with it.`)
    const close = () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false') }
    btn.addEventListener('click', (e) => {
      e.stopPropagation()
      menu.querySelector<HTMLAnchorElement>('[data-open="claude"]')!.href = `https://claude.ai/new?q=${q()}`
      menu.querySelector<HTMLAnchorElement>('[data-open="chatgpt"]')!.href = `https://chatgpt.com/?q=${q()}`
      menu.hidden = !menu.hidden
      btn.setAttribute('aria-expanded', String(!menu.hidden))
    })
    document.addEventListener('click', (e) => { if (!box.contains(e.target as Node)) close() })
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })
  }
</script>

<style is:global>
  /* on a computer the header's Ask AI opens the panel: no second launcher in the corner */
  @media (min-width: 50rem) { agui-chat.ask-chat::part(fab) { display: none; } }
  .ask { position: relative; display: flex; }
  .ask-btn {
    display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 12px 4px 10px; border-radius: 999px;
    border: 1px solid var(--sl-color-hairline-light); background: var(--sl-color-bg-nav); color: var(--sl-color-white);
    font: 500 var(--sl-text-sm) var(--sl-font); cursor: pointer; white-space: nowrap;
  }
  .ask-btn:hover { border-color: var(--sl-color-accent); }
  .ask-btn:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .ask-btn svg { width: 14px; height: 14px; fill: var(--sl-color-accent-high); }
  :root[data-theme='light'] .ask-btn svg { fill: var(--sl-color-accent); }
  .ask-menu {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 20; width: 240px; padding: 8px;
    background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline-light); border-radius: 14px;
    box-shadow: 0 12px 32px -12px hsla(0, 0%, 0%, .35);
  }
  .ask-menu p { margin: 4px 8px 8px; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .ask-menu a { display: block; padding: 8px; border-radius: 10px; color: var(--sl-color-white); text-decoration: none; font-size: var(--sl-text-sm); }
  .ask-menu a:hover, .ask-menu a:focus-visible { background: var(--sl-color-gray-6); outline: none; }
  agui-chat.ask-chat { --agui-accent: var(--sl-color-accent); --agui-on-accent: #fff; --agui-link: var(--sl-color-accent); }
  :root[data-theme='dark'] agui-chat.ask-chat { --agui-accent: var(--sl-color-accent-high); --agui-on-accent: var(--sl-color-black); --agui-link: var(--sl-color-accent-high); }
</style>
