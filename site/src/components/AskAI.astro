---
/**
 * "Ask AI": the project's own <agui-chat> connected to the docs assistant (backend/docs_ai), when the
 * site is built with PUBLIC_ASK_AI_URL. Without it the button offers the current page in Claude or ChatGPT,
 * and nothing is sent to any assistant server.
 */
import { Button, Icon, Menu } from './ui';
const url = import.meta.env.PUBLIC_ASK_AI_URL as string | undefined;
const OPEN = [
  { href: 'https://claude.ai/new', title: 'Open in Claude', external: true, attrs: { 'data-open': 'claude' } },
  { href: 'https://chatgpt.com/', title: 'Open in ChatGPT', external: true, attrs: { 'data-open': 'chatgpt' } },
];
---
<div class="ask" data-ask-ai={url ?? ''}>
  {url ? (
    <Button variant="gray" size="sm" icon="sparkle" class="ask-btn" aria-haspopup="dialog" data-ask-open>Ask AI</Button>
  ) : (
    <Menu label="Ask AI" variant="gray" caption="Ask about this page in your AI assistant:" items={OPEN}>
      <Icon slot="icon" name="sparkle" class="ask-spark" />
    </Menu>
  )}
</div>

<script>
  const STARTERS = [
    'Connect formguide to my React form',
    'Use Azure OpenAI with a cheaper model for research',
    'What does a date question look like?',
    'What is jsx_hash?',
  ]
  const box = document.querySelector<HTMLElement>('[data-ask-ai]')
  const url = box?.dataset.askAi
  const btn = box?.querySelector<HTMLButtonElement>('[data-ask-open]')
  if (box && btn && url) {
    let chat: HTMLElementTagNameMap['agui-chat'] | null = null
    const make = async () => {
      if (chat) return chat
      await import('../../../packages/agui-chat/src/index')
      const { docs } = await import('../ask/docs')
      if (chat) return chat
      const el = document.createElement('agui-chat')
      el.setAttribute('url', url)
      el.setAttribute('mode', 'floating')
      el.setAttribute('persist-thread', 'off')
      el.setAttribute('attach', 'off')
      el.setAttribute('title', 'Ask the docs')
      el.setAttribute('subtitle', 'Answers from these pages, with code')
      el.setAttribute('theme', 'docs')
      el.className = 'ask-chat'
      document.body.appendChild(el)
      el.options = { starters: STARTERS, intro: 'Ask anything about formguide. Code comes straight from these pages.' }
      el.use(docs())
      const scheme = () => el.setAttribute('scheme', document.documentElement.dataset.theme === 'light' ? 'light' : 'dark')
      scheme()
      new MutationObserver(scheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      return (chat = el)
    }
    // the floating button (also on phones, where the header has no room) appears once the page is idle
    ;(window.requestIdleCallback ?? ((f: () => void) => setTimeout(f, 800)))(() => void make())
    // the header button toggles: a second tap closes the panel, like the panel's own close button
    btn.addEventListener('click', async () => {
      const c = await make()
      if (c.shadowRoot?.querySelector('.wrap')?.classList.contains('open')) c.close(); else c.open()
    })
  } else if (box) {
    // no assistant server: the menu offers this page in Claude or ChatGPT (the Menu primitive opens and closes it)
    const md = () => {
      const p = location.pathname.replace(/\/$/, '')
      const base = import.meta.env.BASE_URL.replace(/\/$/, '')
      return location.origin + (p === base ? `${base}/index` : p) + '.md'
    }
    const q = encodeURIComponent(`Read ${md()} (formguide documentation) and help me with it.`)
    box.querySelector<HTMLAnchorElement>('[data-open="claude"]')!.href = `https://claude.ai/new?q=${q}`
    box.querySelector<HTMLAnchorElement>('[data-open="chatgpt"]')!.href = `https://chatgpt.com/?q=${q}`
  }
</script>

<style is:global>
  /* on a computer the header's Ask AI opens the panel: no second launcher in the corner */
  @media (min-width: 50rem) { agui-chat.ask-chat::part(fab) { display: none; } }
  .ask { position: relative; display: flex; }
  .ask .ui-icon.is-fill { color: var(--fg-accent-ink); }
  .ask .ui-pop { width: 15rem; }
  /* the widget in the docs' accent (the panel lives in its own shadow DOM: tokens only) */
  agui-chat.ask-chat { --agui-accent: var(--sl-color-accent); --agui-on-accent: #fff; --agui-link: var(--sl-color-accent); }
  :root[data-theme='dark'] agui-chat.ask-chat { --agui-accent: var(--sl-color-accent-high); --agui-on-accent: var(--sl-color-black); --agui-link: var(--sl-color-accent-high); }
</style>
