---
/**
 * The files of one recipe, read from backend/demo/recipes/<name>/ at build time (lib/recipes.ts): the same files
 * QA's scenarios run, so the page and the measured recipe cannot drift. The .md export prints the same files.
 */
import { Tabs, TabItem, Code } from '@astrojs/starlight/components'
import { recipeFiles } from '../../lib/recipes'
interface Props { name: string }
const files = recipeFiles(Astro.props.name)
const label = (p: string) => p.split('/').pop()!
---
{files.length === 1
  ? <Code code={files[0].code} lang={files[0].lang} title={files[0].path} />
  : <Tabs>{files.map((f) => <TabItem label={label(f.path)}><Code code={f.code} lang={f.lang} title={f.path} /></TabItem>)}</Tabs>}
