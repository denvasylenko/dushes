---
/**
 * The files of one recipe, read from backend/demo/recipes/<name>/ at build time: the same files QA's scenarios run,
 * so the page and the measured recipe cannot drift. formguide.yaml first, then skills, then tool code.
 */
import { Tabs, TabItem, Code } from '@astrojs/starlight/components'
interface Props { name: string }
const { name } = Astro.props
const all = import.meta.glob('../../../../backend/demo/recipes/**/*.{yaml,md,py}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const prefix = `../../../../backend/demo/recipes/${name}/`
const rank = (p: string) => (p === 'formguide.yaml' ? 0 : p.endsWith('.yaml') ? 1 : p.endsWith('.md') ? 2 : 3)
const files = Object.entries(all)
  .filter(([p]) => p.startsWith(prefix) && !p.includes('__pycache__'))
  .map(([p, code]) => ({ path: p.slice(prefix.length), code: code.replace(/\s+$/, '') }))
  .sort((a, b) => rank(a.path) - rank(b.path) || a.path.localeCompare(b.path))
if (!files.length) throw new Error(`RecipeFiles: no files in backend/demo/recipes/${name}/`)
const lang = (p: string) => (p.endsWith('.py') ? 'python' : p.endsWith('.md') ? 'md' : 'yaml')
const label = (p: string) => p.split('/').pop()!
---
{files.length === 1
  ? <Code code={files[0].code} lang={lang(files[0].path)} title={files[0].path} />
  : <Tabs>{files.map((f) => <TabItem label={label(f.path)}><Code code={f.code} lang={lang(f.path)} title={f.path} /></TabItem>)}</Tabs>}
