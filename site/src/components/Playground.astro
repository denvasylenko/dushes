---
/**
 * The widget playground (examples/widget-html: every <agui-chat> setting, a live preview, the code to copy), embedded.
 * It needs the demo server for the widget script and for chatting: PUBLIC_PLAYGROUND_URL points at it
 * (/examples/widget/ on the public host, http://localhost:8000/examples/widget/ locally).
 */
import { Button, CodePanel, Tile } from './ui'
const url = import.meta.env.PUBLIC_PLAYGROUND_URL as string | undefined
const RUN = `cd backend && ANTHROPIC_API_KEY=... uv run uvicorn demo.app:app --port 8000
cd packages/agui-chat && npm run build      # the one-script widget the playground loads
open http://localhost:8000/examples/widget/`
---
<div class="pg not-content">
  {url ? (
    <>
      <div class="pg-bar">
        <span>Changes apply as you make them. Chatting talks to the demo agent (Claude Haiku, 15 messages a chat).</span>
        <Button variant="plain" href={url} target="_blank" rel="noopener">Open full screen</Button>
      </div>
      <iframe class="pg-frame" src={url} title="agui-chat playground" loading="lazy"></iframe>
    </>
  ) : (
    <Tile class="ui-stack">
      <p class="pg-p"><b>The playground runs next to the demo server.</b> Start it and open the playground there:</p>
      <CodePanel label="Terminal" code={RUN} />
      <p class="pg-p">Or build this site with <code>PUBLIC_PLAYGROUND_URL=http://localhost:8000/examples/widget/</code> to embed it here.</p>
    </Tile>
  )}
</div>

<style is:global>
  :root:has(.pg) { --sl-content-width: 76rem; }
  .pg { margin-top: 1rem; }
  .pg-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; font-size: var(--sl-text-sm); color: var(--fg-ink-3); }
  .pg-p { margin: 0; color: var(--fg-ink-2); }
  /* the frame is a Tile-shaped window onto the playground */
  .pg-frame { display: block; width: 100%; height: min(86vh, 900px); border: 0; border-radius: var(--fg-r-tile); background: var(--fg-surface); box-shadow: inset 0 0 0 1px var(--fg-line), 0 0 0 1px var(--fg-line); }
  @media (max-width: 50rem) { .pg-bar { flex-direction: column; align-items: flex-start; gap: 4px; } .pg-frame { height: 80vh; border-radius: var(--fg-r-panel); } }
</style>
