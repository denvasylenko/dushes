{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": { "#lang-loader": ["./src/lang-loader.ts"], "#theme-loader": ["./src/theme-loader.ts"], "#editor-loader": ["./src/editor-loader.ts"], "#tip-loader": ["./src/tip-loader.ts"], "#blocks-loader": ["./src/blocks-loader.ts"], "#charts-loader": ["./src/charts-loader.ts"] }
  },
  "include": ["src", "test"]
}
