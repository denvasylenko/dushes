{
  "name": "@formguide/agui-chat",
  "version": "0.1.0",
  "description": "An installable AG-UI chat: a framework-free Web Component (<agui-chat>) with a formguide plugin and a React wrapper",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/agui-chat.js",
  "module": "./dist/agui-chat.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/agui-chat.js"
    },
    "./formguide": {
      "types": "./dist/types/formguide/index.d.ts",
      "import": "./dist/formguide.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./standalone": "./dist/agui-chat.iife.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.types.json && node scripts/size.mjs",
    "test": "vitest run",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "happy-dom": "^21.0.4",
    "react": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
