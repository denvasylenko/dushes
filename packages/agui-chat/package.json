{
  "name": "@formguide/agui-chat",
  "version": "0.3.0",
  "description": "An installable AG-UI chat: a framework-free Web Component (<agui-chat>) with a formguide plugin and a React wrapper",
  "keywords": [
    "ag-ui",
    "chat",
    "web-component",
    "form",
    "assistant",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denvasylenko/dushes.git",
    "directory": "packages/agui-chat"
  },
  "homepage": "https://dushes-ai.fly.dev/frontend/chat-widget/",
  "bugs": "https://github.com/denvasylenko/dushes/issues",
  "type": "module",
  "imports": {
    "#lang-loader": "./src/lang-loader.ts",
    "#theme-loader": "./src/theme-loader.ts",
    "#editor-loader": "./src/editor-loader.ts",
    "#tip-loader": "./src/tip-loader.ts",
    "#highlight-loader": "./src/highlight-loader.ts",
    "#blocks-loader": "./src/blocks-loader.ts",
    "#charts-loader": "./src/charts-loader.ts"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/agui-chat.js",
  "module": "./dist/agui-chat.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/agui-chat.js"
    },
    "./formguide": {
      "types": "./dist/types/formguide/index.d.ts",
      "import": "./dist/formguide.js"
    },
    "./highlight": {
      "types": "./dist/types/highlight.d.ts",
      "import": "./dist/highlight.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react-hook-form": {
      "types": "./dist/types/rhf.d.ts",
      "import": "./dist/react-hook-form.js"
    },
    "./standalone": "./dist/agui-chat.iife.js",
    "./lang/*": "./dist/agui-chat.lang-*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --config vite.iife.config.ts && vite build --config vite.editor.config.ts && vite build --config vite.tip.config.ts && vite build --config vite.highlight.config.ts && vite build --config vite.blocks.config.ts && vite build --config vite.charts.config.ts && node scripts/lang-files.mjs && tsc -p tsconfig.types.json && node scripts/size.mjs",
    "test": "vitest run",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "happy-dom": "^21.0.4",
    "react": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chart.js": "4.5.1"
  }
}
